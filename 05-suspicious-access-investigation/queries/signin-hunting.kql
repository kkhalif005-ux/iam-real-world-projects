// Suspicious sign-in hunting in Microsoft Sentinel or Log Analytics.
// Requires Entra ID sign-in logs sent to the workspace
// (Entra admin center > Monitoring & health > Diagnostic settings > SigninLogs).

// 1. One user's last 30 days: where, what device, what result
let user = "jordan.reed@yourtenant.onmicrosoft.com";
SigninLogs
| where TimeGenerated > ago(30d) and UserPrincipalName =~ user
| project TimeGenerated, IPAddress, City = tostring(LocationDetails.city),
          Country = tostring(LocationDetails.countryOrRegion),
          OS = tostring(DeviceDetail.operatingSystem), Browser = tostring(DeviceDetail.browser),
          AppDisplayName, ClientAppUsed, ResultType, RiskLevelDuringSignIn
| order by TimeGenerated desc

