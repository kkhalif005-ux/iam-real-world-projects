// | where ResourceProvider == "MICROSOFT.KEYVAULT" and OperationName == "SecretGet"
// | extend LocalHour = datetime_part("hour", datetime_utc_to_local(TimeGenerated, "America/Chicago"))
// | where LocalHour < 7 or LocalHour > 19

// --- Rotations: new secret versions written ---
// AzureDiagnostics
// | where ResourceProvider == "MICROSOFT.KEYVAULT" and OperationName == "SecretSet"
// | project TimeGenerated, Secret = tostring(split(id_s, "/")[4]), CallerIPAddress
